# Cloudflare Workers Static Assets serves this file: one path pattern and its
# headers. The site is static HTML with inline <style> and no script, so the
# policy can be as tight as the page allows: no external origins, no framing,
# and no plugin content types.

/*
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains