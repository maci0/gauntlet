# Runtime environment variables

# GitHub API token for release checks and downloads (optional; GH_TOKEN wins
# when both carry a token, an empty one is ignored)
# GITHUB_TOKEN=ghp_example_token_placeholder
# GH_TOKEN=ghp_example_token_placeholder

# State root directory: journals, reload handoff, agents.json (default: ~/.gauntlet).
# A leading ~ and any $VAR expand, an empty value is the variable unset, and a
# path that is not a directory is refused at startup. `gauntlet doctor` prints
# the root in use and where it came from.
# GAUNTLET_HOME=~/.gauntlet

# Reduce motion: hold the dashboard's reasoning glyph still and stop the screen
# repainting itself ten times a second; it redraws on a report or a keypress,
# and every thirty seconds otherwise
# GAUNTLET_NO_ANIMATION is read first, so set it to 0 or false to overrule the two below
# GAUNTLET_NO_ANIMATION=1
# NO_MOTION=1
# REDUCED_MOTION=1

# Git SSH command override (default: ssh)
# GIT_SSH_COMMAND=ssh

# Terminal color controls
# NO_COLOR=1
# CLICOLOR_FORCE=1
# FORCE_COLOR=1
# TERM=xterm-256color

# Absolute existing temporary directory: also writable by sandboxed agents.
# make test ignores exported TMPDIR; override on the make command line.
# TMPDIR=/tmp
