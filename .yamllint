# The CI definitions are the repository's second syntax: a workflow that
# parses is not a workflow GitHub accepts. `make check-scripts` runs
# yamllint, and ci.yml's scripts job runs the same command, so a broken
# definition fails on a pull request instead of on the tag that needs it.
#
# Four settings leave yamllint's own values, each for a reason that is in the
# entry it covers: document-start is dropped, truthy stops checking keys,
# comments asks for one space, and the line-length cap rises from 80 to 120.
# Every other rule keeps yamllint's setting.
extends: default

rules:
  # GitHub reads a workflow as a bare mapping; the document-start marker is
  # not part of that, and no workflow in this tree carries one.
  document-start: disable

  # `on:` is a key whose value is the string "on", not the boolean true. Only
  # values are checked, so a genuinely truthy value (an unquoted `yes` in a
  # step field) still fails.
  truthy:
    check-keys: false

  # The longest line in the workflows is 115 characters, a run-block echo in
  # release.yml. 120 caps the tree without reflowing it; raise it only with
  # the code, and lower it only when the longest line is already under it.
  line-length:
    max: 120

  # One space before an inline comment, which is what the Go sources use
  # (`m.scroll = 0 // back to the live edge`). yamllint's default of two is
  # not this repository's convention.
  comments:
    min-spaces-from-content: 1
